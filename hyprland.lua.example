-- Neon Foundry — Hyprland window chrome. NOT SHIPPED AS-IS.
--
-- Omarchy drops every *.lua from a theme installed out of a git clone, because
-- a theme's hyprland.lua is loaded at login and a theme is not allowed to ship
-- code. It regenerates the file from colors.toml instead. So this cannot reach
-- anyone who runs `omarchy theme install`, and it carries the .example suffix
-- to say so: staging keeps the file and nothing loads it.
--
-- install.sh copies it to hyprland.lua for a linked install, where Omarchy
-- treats the theme as the user's own and does load it. That copy is ignored by
-- git. The gradient border itself does not depend on any of this — it is
-- declared in colors.toml as hyprland_active_border and survives either way.
-- What is here and nowhere else is the glow under the focused window, which
-- no template can express.

local active_border_color = {
  colors = { "rgba(c8ff00ee)", "rgba(31e5ffee)", "rgba(ff2e8bee)" },
  angle = 45,
}
local inactive_border_color = {
  colors = { "rgba(27292daa)", "rgba(0e0f12aa)" },
  angle = 45,
}
-- The glow carries the same three stops on the same 45-degree sweep as the
-- border, so the corner that is magenta on the border is magenta underneath it
-- too. A flat accent here clashes: the bottom-right ends up pink over green.
local active_shadow_color = {
  colors = { "rgba(c8ff0033)", "rgba(31e5ff33)", "rgba(ff2e8b33)" },
  angle = 45,
}
local inactive_shadow_color = "rgba(06070977)"

hl.config({
  general = {
    col = {
      active_border = active_border_color,
      inactive_border = inactive_border_color,
    },
  },

  group = {
    col = {
      border_active = active_border_color,
      border_inactive = inactive_border_color,
    },
  },

  decoration = {
    shadow = {
      enabled = true,
      range = 8,
      render_power = 3,
      color = active_shadow_color,
      color_inactive = inactive_shadow_color,
    },
  },
})
